# ==============================================================================
# PROBEND / ALGOR - VARIÁVEIS DE AMBIENTE (.env)
# Copie este arquivo para .env no servidor antes de iniciar:
#   cp .env.example .env
# ==============================================================================

# Perfil do Docker Compose:
#   - infra: Apenas banco, redis, rabbitmq, minio e mailpit (desenvolvimento local)
#   - full:  Stack completo com containers de Backend (Spring) e Frontend (Nginx)
COMPOSE_PROFILES=full

# ==================== REDE E PORTAS ====================
# Binds de porta do frontend e backend
# Para expor publicamente no servidor/VPS: 0.0.0.0
# Para manter acessível apenas internamente/proxy reverso externo: 127.0.0.1
FRONTEND_BIND=0.0.0.0
FRONTEND_PORT=8081

BACKEND_BIND=127.0.0.1
BACKEND_PORT=8080

# ==================== BANCO DE DADOS (MySQL) ====================
DB_BIND=127.0.0.1
DB_PORT=3307
DB_USER=root
MYSQL_ROOT_PASSWORD=altere_para_uma_senha_muito_forte_aqui
DB_NAME=probend_db
DB_USE_SSL=false

# ==================== SEGURANÇA E AUTENTICAÇÃO (JWT & CORS) ====================
# Chave secreta HMAC-SHA do JWT (OBRIGATÓRIO: mínimo 32 caracteres)
JWT_SECRET=defina_uma_chave_secreta_com_mais_de_32_caracteres_aleatorios_aqui

# Origens permitidas no CORS (separadas por vírgula)
# IMPORTANTE: inclua a URL ou IP pelo qual o usuário acessa o frontend no navegador
APP_SECURITY_ALLOWED_ORIGINS=http://localhost:8081,http://SEU_IP_OU_DOMINIO:8081

# Flag de segurança para cookies HTTP-Only (AUTH_TOKEN):
# - Defina como 'true' APENAS se sua aplicação estiver rodando com HTTPS (SSL/TLS).
# - Defina como 'false' se estiver acessando diretamente via HTTP puro (ex: http://IP:8081),
#   caso contrário os navegadores descartarão o cookie e o login não persistirá.
APP_SECURITY_COOKIE_SECURE=false

# ==================== ARMAZENAMENTO DE ARQUIVOS (MinIO / S3) ====================
MINIO_BIND=127.0.0.1
MINIO_PORT=9000
MINIO_CONSOLE_BIND=127.0.0.1
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=admin_minio_seguro
MINIO_ROOT_PASSWORD=altere_para_uma_senha_minio_forte_aqui

# ==================== CACHE E FILAS (Redis & RabbitMQ) ====================
REDIS_BIND=127.0.0.1
REDIS_PORT=6379

RABBITMQ_AMQP_BIND=127.0.0.1
RABBITMQ_AMQP_PORT=5672
RABBITMQ_WEB_BIND=127.0.0.1
RABBITMQ_WEB_PORT=15672
RABBITMQ_DEFAULT_USER=rabbit_admin
RABBITMQ_DEFAULT_PASS=altere_para_uma_senha_rabbit_forte_aqui

# ==================== SERVIÇO DE E-MAIL (SMTP) ====================
# Padrão: Mailpit local (útil para portfólio e testes sem SMTP externo)
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_AUTH=false
SPRING_MAIL_STARTTLS=false

MAILPIT_SMTP_BIND=127.0.0.1
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_BIND=127.0.0.1
MAILPIT_WEB_PORT=8025

# ==================== INTELIGÊNCIA ARTIFICIAL (Google Gemini) ====================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
