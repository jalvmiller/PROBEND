# ==============================================================================
# PROBEND - Variáveis de Ambiente (.env) [Branch: refactor/angular]
# ==============================================================================
# Copie este arquivo para '.env' na raiz do projeto:
#   - No seu PC (Desenvolvimento Local Híbrido): use COMPOSE_PROFILES=infra
#   - No EC2 (Produção com todos os containers): use COMPOSE_PROFILES=full
# ==============================================================================

# Perfil padrão do Docker Compose (infra ou full)
# 'infra': sobe apenas db, redis, minio, mailpit, rabbitmq (ideal para dev no host)
# 'full': sobe todos os contêineres, incluindo backend e frontend
COMPOSE_PROFILES=infra

# ==================== Banco de Dados (MySQL) ====================
DB_USER=root
MYSQL_ROOT_PASSWORD=root1234
DB_PORT=3307
DB_BIND=127.0.0.1
DB_USE_SSL=false

# ==================== Autenticação & Segurança ====================
JWT_SECRET=ChaveSuperSecretaDeDesenvolvimentoParaTestesLocais32Chars!
APP_SECURITY_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:4200
APP_SECURITY_COOKIE_SECURE=false

# ==================== Inteligência Artificial (Google Gemini) ====================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ==================== MinIO / S3 ====================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminpassword
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BIND=127.0.0.1
MINIO_CONSOLE_BIND=127.0.0.1

# ==================== RabbitMQ ====================
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_AMQP_PORT=5672
RABBITMQ_WEB_PORT=15672
RABBITMQ_AMQP_BIND=127.0.0.1
RABBITMQ_WEB_BIND=127.0.0.1

# ==================== Redis ====================
REDIS_PORT=6379
REDIS_BIND=127.0.0.1

# ==================== Mail / Mailpit ====================
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_AUTH=false
SPRING_MAIL_STARTTLS=false
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_BIND=127.0.0.1
MAILPIT_WEB_BIND=127.0.0.1

# ==================== Portas e Binds da Aplicação (Modo Full / EC2) ====================
BACKEND_PORT=8080
BACKEND_BIND=127.0.0.1

# No EC2, altere para FRONTEND_BIND=0.0.0.0 e FRONTEND_PORT=80 caso queira expor publicamente
FRONTEND_PORT=8081
FRONTEND_BIND=127.0.0.1
